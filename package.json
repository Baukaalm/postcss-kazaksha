{
  "name": "postcss-kazaksha",
  "version": "2.0.0",
  "description": "PostCSS плагині - қазақша CSS жазып, стандартты CSS-ке аударыңыз",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dictionary": {
      "import": {
        "types": "./dist/dictionary/index.d.ts",
        "default": "./dist/dictionary/index.js"
      },
      "require": {
        "types": "./dist/dictionary/index.d.cts",
        "default": "./dist/dictionary/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./vscode-data": "./dist/vscode/kazaksha.css-data.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/generate-vscode-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc && tsc -p playground",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "tsc -p playground && vite build --config playground/vite.config.ts"
  },
  "keywords": [
    "postcss",
    "postcss-plugin",
    "css",
    "kazakh",
    "kazaksha",
    "қазақша",
    "i18n"
  ],
  "author": "baur.sha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Baukaalm/postcss-kazaksha.git"
  },
  "bugs": {
    "url": "https://github.com/Baukaalm/postcss-kazaksha/issues"
  },
  "homepage": "https://github.com/Baukaalm/postcss-kazaksha#readme",
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "dependencies": {
    "postcss-selector-parser": "^7.1.0",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@gravity-ui/icons": "^2.23.1",
    "@heroui/react": "3.2",
    "@heroui/styles": "3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vscode/web-custom-data": "^0.6.4",
    "postcss": "^8.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.0"
  }
}
